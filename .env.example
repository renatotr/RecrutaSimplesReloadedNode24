# Base URL of the legacy API.
# Local dev: leave EMPTY (browser → https://localhost:9001, Vite proxies /api and /user/* to :4000).
# Never use https://localhost:4000 here in dev — causes CORS with credentials.
# Production (same origin): leave empty.
VITE_API_BASE_URL=

# Session validation endpoint (GET + HttpOnly session cookie).
VITE_SESSION_PATH=/api/auth/iframe-validation

# Local dev: legacy backend origin for the Vite proxy.
VITE_DEV_LEGACY_ORIGIN=https://localhost:4000

# React dev app URL — use this as iframe src in the legacy app (Option B: HTTPS + SameSite=None).
VITE_DEV_APP_ORIGIN=https://localhost:9001

# Exposed to the app via vite.config (development | test | production).
NODE_ENV=development

# Optional: Node trusts system CAs for the proxy target (mkcert).
# npm run dev:system-ca
