# Base URL of the legacy API (browser fetch target in dev).
# Local dev: leave EMPTY or use https://localhost:9001 (Vite proxies below).
# Never put legacy origin in VITE_API_BASE_URL — causes CORS with credentials.
# Production (cross-subdomain): https://www.recrutasimples.com.br (or leave empty if same host).
VITE_API_BASE_URL=

# Reloaded iframe API prefix — all legacy API calls from this app use paths under this prefix.
VITE_API_PATH_PREFIX=/api/reloaded

# Session validation path relative to VITE_API_PATH_PREFIX (GET + HttpOnly session cookie).
VITE_SESSION_RELATIVE_PATH=/auth/iframe-validation

# Local dev: legacy origin for the Vite proxy (/api/reloaded and /painel).
VITE_DEV_LEGACY_ORIGIN=https://localhost:3001

# React dev app URL — use this as iframe src in the legacy app (HTTPS + SameSite=None).
VITE_DEV_APP_ORIGIN=https://localhost:9001

# Exposed to the app via vite.config (development | test | production).
NODE_ENV=development

# Optional: Node trusts system CAs for the proxy target (mkcert).
# npm run dev:system-ca
