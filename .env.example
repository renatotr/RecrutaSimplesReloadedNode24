# Base URL of the legacy API.
# Local dev: leave empty so /api/... is proxied by Vite (see vite.config.ts).
# Production (same origin): leave empty or set to your public origin.
VITE_API_BASE_URL=

# Session validation endpoint (GET + HttpOnly session cookie).
VITE_SESSION_PATH=/api/auth/iframe-validation

# Local dev only: legacy backend origin for the Vite proxy.
VITE_DEV_LEGACY_ORIGIN=https://localhost:4000

# If you prefer Node to trust system CAs (mkcert) instead of skipping TLS verify,
# run: npm run dev:system-ca
